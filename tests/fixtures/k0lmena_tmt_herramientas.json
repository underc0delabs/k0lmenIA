{
 "_origen": "tools/list del server MCP de k0lmenaTMT (underc0delabs/k0lmenatmt:latest, 2026-10-24)",
 "herramientas": {
  "get_dashboard_stats": {
   "type": "object",
   "properties": {
    "projectId": {
     "type": "number",
     "description": "Optional. Restrict to a single project the user has access to. Omit for all projects."
    },
    "dateRange": {
     "type": "string",
     "enum": [
      "7d",
      "30d",
      "90d",
      "all"
     ],
     "description": "Time window for the stats. Defaults to 30d."
    }
   }
  },
  "query_test_cases": {
   "type": "object",
   "properties": {
    "projectId": {
     "type": "number",
     "description": "Optional. Single accessible project. Omit for all."
    },
    "status": {
     "type": "string",
     "enum": [
      "NOT_RUN",
      "PASS",
      "FAILED",
      "SKIPPED"
     ],
     "description": "Filter by status."
    },
    "automated": {
     "type": "boolean",
     "description": "Filter by automation flag."
    },
    "priorityId": {
     "type": "number",
     "description": "Filter by priority id."
    },
    "directoryId": {
     "type": "number",
     "description": "Filter by directory (folder) id."
    },
    "tag": {
     "type": "string",
     "description": "Filter cases whose tags contain this substring."
    },
    "limit": {
     "type": "number",
     "description": "Max sample rows to return (default 25, max 100)."
    }
   }
  },
  "query_executions": {
   "type": "object",
   "properties": {
    "projectId": {
     "type": "number",
     "description": "Optional. Single accessible project. Omit for all."
    },
    "status": {
     "type": "string",
     "enum": [
      "pending",
      "running",
      "completed",
      "failed"
     ],
     "description": "Filter by suite status."
    },
    "fromDate": {
     "type": "string",
     "description": "ISO date — only executions executed on/after this date."
    },
    "toDate": {
     "type": "string",
     "description": "ISO date — only executions executed on/before this date."
    },
    "limit": {
     "type": "number",
     "description": "Max sample rows (default 25, max 100)."
    }
   }
  },
  "get_most_failing_tests": {
   "type": "object",
   "properties": {
    "projectId": {
     "type": "number",
     "description": "Optional. Single accessible project. Omit for all."
    },
    "limit": {
     "type": "number",
     "description": "How many tests to return (default 10, max 50)."
    }
   }
  },
