# ─────────────────────────────────────────────────────────────
#  Variables de entorno — k0lmenIA
# ─────────────────────────────────────────────────────────────
#  Copiá este archivo a ".env" y completá los valores reales:
#
#      cp .env.example .env      (y editás .env)
#
#  El ".env" está en .gitignore: NUNCA se commitea.
#  No subas usuarios, contraseñas ni tokens al repositorio.
#  Usá credenciales de un entorno de prueba / staging, no de producción.
# ─────────────────────────────────────────────────────────────


# --- App bajo prueba (ejecución E2E con Playwright MCP) ---

# URL de la aplicación a probar
APP_URL=https://tu-app-de-prueba.com

# Credenciales de login (solo si la app las pide)
APP_USER=tu_usuario
APP_PASSWORD=tu_password


# --- Pruebas de API (Newman) ---
# Token para autenticar los requests de API (si tu colección usa {{token}}).
# Lo pasa scripts/correr_newman.py (agente ejecutor-api) como la variable {{token}} de la colección
# API_TOKEN=


# --- Automatización con k0lmena (herramientas/k0lmena) ---
# k0lmena lee ESTE mismo .env (no hay otro). También usa APP_USER, APP_PASSWORD y API_TOKEN de arriba.

# Filtro de escenarios (vacío = todos). Ej: @HU-001   |   @smoke and not @wip
TAGS=
# Paralelo en web/api: vacío o 0 = secuencial | on = un worker por CPU | N = N workers
PARALLEL=

# Web (Playwright + Cucumber). Si BASEURL queda vacío, se usa APP_URL.
BASEURL=https://qarmy.ar/practica/automation
BROWSER=chromium
HEADLESS=true
SLOWMO=0
REPORT_DIR=reports/web
# Evidencias en el reporte (web y mobile):
#   TRACE: off | on | on-failure  (trace de Playwright, para abrir en trace.playwright.dev)
#   VIDEO: off | on | on-failure  (video completo de la ejecución)
#   EVIDENCE: captura | ambos | off  (de cada escenario que pasa: captura final, o captura + GIF del recorrido)
#             Vacío = npm test lo pregunta al arrancar (en CI usa "captura").
TRACE=on-failure
VIDEO=on-failure
EVIDENCE=
VIEWPORT_WIDTH=1366
VIEWPORT_HEIGHT=768
LOCALE=es-AR
TIMEZONE=America/Argentina/Mendoza

# Auto-healing de locators: off | learn | heal | on
K0LMENA_AUTO_HEALING=on
K0LMENA_AUTO_HEALING_FLUSH=debounced
K0LMENA_AUTO_HEALING_WRITE_PRETTY=0
K0LMENA_AUTO_HEALING_LOG=0
K0LMENA_AUTO_HEALING_CONSOLE=1
K0LMENA_AUTO_HEALING_HISTORY_PATH=.k0lmena/auto-healing/front-history.json
K0LMENA_AUTO_HEALING_MAX_CANDIDATES=12
K0LMENA_AUTO_HEALING_SNAPSHOT_TIMEOUT_MS=250
K0LMENA_AUTO_HEALING_CANDIDATE_TIMEOUT_MS=1500

# API (axios + Cucumber). El token es API_TOKEN (sección Newman).
API_BASEURL=https://petstore.swagger.io

# Mobile (WebdriverIO + Appium)
# MOBILE_TARGET: device | emulator | browserstack     MOBILE_PLATFORM: Android | iOS
MOBILE_TARGET=emulator
MOBILE_PLATFORM=Android
MOBILE_DEVICE_NAME=emulator-5554
MOBILE_PLATFORM_VERSION=
# Archivo dentro de herramientas/k0lmena/mobile/apps/ (o ruta absoluta)
MOBILE_APP=app.apk
# Solo MOBILE_TARGET=device (sale de `adb devices`)
MOBILE_UDID=
# Solo MOBILE_TARGET=browserstack (BROWSERSTACK_APP = bs://... de la app subida)
BROWSERSTACK_USER=
BROWSERSTACK_KEY=
BROWSERSTACK_APP=
BROWSERSTACK_BUILD=k0lmenIA

# Performance (npm run perf, agente performance-mapper). La carga y los umbrales van en cada
# script; k6 usa API_BASEURL / BASEURL y el token API_TOKEN. Opcionales:
#   PERF_VUS / PERF_DURACION: pisan la carga de un script k6 en todas las corridas (ej. 5 y 1m)
PERF_VUS=
PERF_DURACION=


# --- Bases de datos (agente verificador-datos y steps de BD de k0lmena) ---
# Conexiones con nombre; la primera es la de por defecto. Motores: postgres | mysql | mariadb | sqlserver | mongodb
# Por conexión: DB_<NOMBRE>_URL (opcional, reemplaza host/puerto/base/usuario/clave) o HOST, PUERTO, BASE, USUARIO, CLAVE.
# Seguridad: solo lectura por defecto. ESCRITURA=si permite escribir con confirmación explícita;
# PRODUCCION=si bloquea toda escritura. Recomendado: un usuario de base de datos con permisos de solo lectura.
DB_CONEXIONES=
# DB_PRINCIPAL_MOTOR=postgres
# DB_PRINCIPAL_HOST=localhost
# DB_PRINCIPAL_PUERTO=5432
# DB_PRINCIPAL_BASE=
# DB_PRINCIPAL_USUARIO=
# DB_PRINCIPAL_CLAVE=
# SSL: no | si (cifra y verifica el certificado del servidor) | sin-verificar (acepta certificados
#      autofirmados: solo ambientes de prueba). Con una CA propia, DB_PRINCIPAL_SSL_CA=ruta/ca.pem
# DB_PRINCIPAL_SSL=no
# DB_PRINCIPAL_ESCRITURA=no
# DB_PRINCIPAL_PRODUCCION=no
# Opcionales: DB_FILAS_MAX=50 (filas que muestra el CLI) · DB_TIMEOUT_MS=30000 · DB_ESPERA_MS=5000 (reintentos de los steps)
#             DB_COLUMNAS_SENSIBLES=dni,telefono (se suman a password, token, clave, hash, tarjeta… que ya se enmascaran)


# --- Seguridad web (agente analista-seguridad, OWASP ZAP en Docker) ---
# Solo se escanean (en modo pasivo) los sitios de esta lista: propios o con autorización
# por escrito de sus dueños. Separados por coma; cada URL cubre sus subrutas.
SEGURIDAD_URLS_AUTORIZADAS=
# Imagen de ZAP (opcional): ghcr.io/zaproxy/zaproxy:stable por defecto
# ZAP_IMAGEN=


# ═════════════════════════════════════════════════════════════
#  INTEGRACIONES — gestión de proyecto, diseño y gestión de pruebas
# ═════════════════════════════════════════════════════════════
#  Cada equipo usa sus herramientas: completá y descomentá solo los bloques que uses.
#  Viene activo Jira + Confluence (conector "atlassian"); el resto está listo, comentado.
#
#  Conectores MCP: todos están en .mcp.json, sin secretos (los valores salen de este .env).
#  Vienen habilitados "playwright", "playwright-headless" y "atlassian". Para habilitar otro,
#  sumalo en .claude/settings.local.json:
#      "enabledMcpjsonServers": ["playwright", "playwright-headless", "atlassian", "azure-devops"]
#  y reiniciá Claude Code. Guía completa: CONECTORES.md · scripts/gestion/README.md


# --- Jira y Confluence (Atlassian Cloud) · ACTIVO POR DEFECTO ---
# Conector MCP "atlassian": historias, comentarios, épicas, issues vinculados y páginas de Confluence.
# Autenticación del conector:
#   oauth  (por defecto) autorizás con tu cuenta la primera vez, desde /mcp > atlassian. No usa token.
#   token  usa JIRA_EMAIL + JIRA_API_TOKEN. Un admin de Atlassian tiene que habilitarlo en
#          Atlassian Administration > Rovo > Rovo MCP server > Authentication.
ATLASSIAN_MCP_AUTENTICACION=oauth
JIRA_BASE_URL=https://tu-sitio.atlassian.net
JIRA_EMAIL=
# API token personal: https://id.atlassian.com/manage-profile/security/api-tokens
# (también lo usa la integración con Xray Cloud para vincular casos con historias)
JIRA_API_TOKEN=
# Opcional, en lugar del token personal: API key de una cuenta de servicio (se envía como Bearer)
# ATLASSIAN_API_KEY=


# --- Azure DevOps (Boards, Test Plans y Wiki) ---
# Conector MCP "azure-devops": historias, comentarios, Wiki y casos en Azure Test Plans.
# Organización: solo el nombre, el de https://dev.azure.com/<organizacion>
# ADO_ORGANIZACION=
# Personal Access Token (User settings > Personal access tokens). Scopes mínimos:
#   Work Items (Read & write), Test Management (Read & write), Project and Team (Read),
#   Wiki (Read) y, para la búsqueda de código, Code (Read).
# ADO_PAT=
# Proyecto y equipo por defecto (opcionales; si faltan, se indican en cada pedido)
# ADO_PROYECTO=
# ADO_EQUIPO=
# Opcionales:
#   ADO_AUTENTICACION: pat (por defecto, usa ADO_PAT) | interactive (login en el navegador) | azcli (sesión de "az login")
#   ADO_TENANT: tenant de Microsoft Entra (solo interactive o azcli)
#   ADO_DOMINIOS: áreas que se habilitan (por defecto: core work work-items test-plans wiki search)
# ADO_AUTENTICACION=pat
# ADO_TENANT=
# ADO_DOMINIOS=core work work-items test-plans wiki search


# --- Figma (diseños) ---
# Conectores MCP "figma" (remoto) o "figma-desktop" (app de escritorio). No usan variables:
# se autorizan con tu cuenta de Figma desde /mcp. Requiere un asiento Full o Dev.


# --- Herramienta de gestión de pruebas (agentes gestor-pruebas y publicador-resultados) ---
# Xray, QTM4J y AIO se integran con scripts/gestion/gestion.py (carpetas, casos, vínculos,
# ciclos y resultados con evidencias). Azure DevOps va por su conector MCP (bloque de arriba).
# GESTION_HERRAMIENTA: xray-cloud | xray-dc | qtm4j | aio
# GESTION_PROYECTO: key del proyecto de Jira (ej. PROJ)
# GESTION_HERRAMIENTA=
# GESTION_PROYECTO=


# --- Xray Cloud ---
# Sin MCP oficial: lo integra scripts/gestion. Usa también JIRA_BASE_URL, JIRA_EMAIL y JIRA_API_TOKEN.
# API key de Xray: Xray > Global Settings > API Keys
# XRAY_CLOUD_CLIENT_ID=
# XRAY_CLOUD_CLIENT_SECRET=
# Región (opcional): https://us.xray.cloud.getxray.app | https://eu.xray.cloud.getxray.app | https://au.xray.cloud.getxray.app
# XRAY_CLOUD_URL=https://xray.cloud.getxray.app


# --- Xray Server / Data Center ---
# URL de tu Jira + Personal Access Token (o usuario y contraseña)
# XRAY_DC_URL=https://jira.tu-empresa.com
# XRAY_DC_TOKEN=
# XRAY_DC_USER=
# XRAY_DC_PASSWORD=


# --- QMetry para Jira Cloud (QTM4J) ---
# Lo usan scripts/gestion y el conector MCP "qtm4j". Open API key: QMetry > Configuration > Open API
# Región: https://qtmcloud.qmetry.com (US) | https://syd-qtmcloud.qmetry.com (AU) | https://eu-qtm4j-cloud.qmetry.com (EU)
# QTM4J_API_KEY=
# QTM4J_BASE_URL=https://qtmcloud.qmetry.com
# Solo para las herramientas de automatización del conector MCP (opcional)
# QTM4J_AUTOMATION_API_KEY=


# --- QMetry Test Management (standalone) ---
# Conector MCP "qmetry" (server oficial de SmartBear). Open API key de QMetry.
# QMETRY_API_KEY=
# QMETRY_BASE_URL=https://testmanagement.qmetry.com


# --- AIO Tests (Jira Cloud) ---
# Lo usan scripts/gestion y el conector MCP "aio-tests". API token: AIO Tests > My Settings > API Token
# AIO_API_TOKEN=
# URL del server MCP (única por tenant): AIO Tests > My Settings > MCP Authorization
# AIO_MCP_URL=https://tcms-prod-us.aiojiraapps.com/aiotcms-mcp/v1/<tu-tenant-id>/mcp


# --- k0lmenaTMT ---
# Conector MCP "k0lmena-tmt". Token personal (kolm_pat_...) generado en k0lmenaTMT.
# K0LMENA_TMT_TOKEN=
# La URL por defecto es http://localhost:4000/api/v1/mcp. Para otra, definila en el ENTORNO
# antes de lanzar "claude" (es lo único que Claude Code no toma de este .env):
# K0LMENA_TMT_URL=http://localhost:4000/api/v1/mcp


# --- Appium (mobile-mapper) ---
# Conector MCP "appium-mcp": ruta al Android SDK, si no está en el entorno
# ANDROID_HOME=


# --- Ajustes opcionales de scripts/gestion (ver scripts/gestion/README.md) ---
# GESTION_LIMITE_ADJUNTO_MB=   tope de tamaño por evidencia (Xray Server/DC: 10 por defecto)
# GESTION_ENVIAR_PRIORIDAD=0   no enviar prioridad al crear casos (si tu Jira usa otros nombres)
# GESTION_PRIORIDADES={"Crítica":"Highest","Alta":"High","Media":"Medium","Baja":"Low"}
# XRAY_LINK_CASO=Test          tipo de vínculo caso-historia (Server/DC: se detecta solo)
# XRAY_LINK_CICLO=Relates      tipo de vínculo ejecución-historia
# XRAY_LINK_INVERTIR=1         si el vínculo queda al revés (la historia debe decir "is tested by")
# XRAY_ESTADOS / QTM4J_ESTADOS / AIO_ESTADOS   JSON para mapear estados propios, ej. {"bloqueado":"BLOCKED"}
# AIO_ESTADO_CASO=Published    estado con el que se crean los casos en AIO
