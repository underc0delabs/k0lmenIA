# ╔═══════════════════════════════════════════════════════════════╗
# ║                                                               ║
# ║                      k 0 l m e n I A                          ║
# ║                 Variables de entorno  ·  .env                 ║
# ║                                                               ║
# ╚═══════════════════════════════════════════════════════════════╝
#
#   ┌─ CÓMO USAR ESTE ARCHIVO ──────────────────────────────────┐
#   │                                                            │
#   │   1)  Copialo a ".env":     cp .env.example .env           │
#   │   2)  Editá SOLO lo que uses (abajo te guía cada bloque).  │
#   │   3)  Para activar una línea comentada, borrale el "#".    │
#   │                                                            │
#   └────────────────────────────────────────────────────────────┘
#
#   ETIQUETAS QUE VAS A VER EN CADA VARIABLE
#   ----------------------------------------
#     [OBLIGATORIO]  ·  completalo para arrancar
#     [OPCIONAL]     ·  solo si usás esa función
#     [SECRETO]      ·  token o clave: NUNCA se sube al repo
#
#   REGLAS DE ORO
#   -------------
#     •  El ".env" está en .gitignore: nunca se commitea.
#     •  Usá credenciales de PRUEBA / staging, nunca de producción.
#     •  Si una línea está comentada (#), es opcional: dejala así si no la usás.
#     •  ¿Perdido? Cada bloque dice para qué agente o herramienta sirve.
#
#   LO MÍNIMO PARA EMPEZAR
#   ----------------------
#     Con solo esto ya podés usar la mayoría de los agentes:
#         APP_URL        → la web que vas a probar
#         APP_USER       → usuario de login   (si la app lo pide)
#         APP_PASSWORD   → clave de login     (si la app lo pide)
#     Todo lo demás es opcional y se activa cuando lo necesites.
#
#   MAPA DEL ARCHIVO
#   ----------------
#     1 · APLICACIÓN Y ACCESO              4 · SEGURIDAD, STREAMING Y CÁMARAS
#     2 · API Y AUTOMATIZACIÓN k0lmena     5 · OTROS AGENTES
#     3 · BASES DE DATOS                   6 · INTEGRACIONES (Jira, Azure, Xray…)
#
# ───────────────────────────────────────────────────────────────




# ╔═══════════════════════════════════════════════════════════════╗
# ║   1 · APLICACIÓN Y ACCESO                                     ║
# ╚═══════════════════════════════════════════════════════════════╝


# ┌───────────────────────────────────────────────────────────────
# │  APP BAJO PRUEBA        ·  ejecución E2E con Playwright MCP
# └───────────────────────────────────────────────────────────────
#
# URL de la aplicación a probar: la única. La usan los agentes, las herramientas y la automatización
# web de k0lmena (que la lee como BASEURL; no hace falta definir BASEURL aparte).
#
# [OBLIGATORIO]
APP_URL=https://tu-app-de-prueba.com

# Credenciales de login (solo si la app las pide).
# [OPCIONAL]  [SECRETO]
APP_USER=tu_usuario
APP_PASSWORD=tu_password


# ┌───────────────────────────────────────────────────────────────
# │  SESIÓN GUARDADA        ·  npm run login
# └───────────────────────────────────────────────────────────────
#
# npm run login abre el navegador, te logueás a mano y guarda la sesión en .auth/ (gitignored).
# SESION decide si la usan las suites web de k0lmena (npm test) y el navegador de los agentes:
#   vacío = no se usa | si = .auth/sesion.json | <nombre> = .auth/sesion-<nombre>.json (npm run login -- --nombre <nombre>)
# Los escenarios con @sin-sesion arrancan siempre sin sesión. El navegador de los agentes toma el cambio al reiniciar Claude Code.
#
# [OPCIONAL]
SESION=
# Página donde abre npm run login (por defecto APP_URL).  [OPCIONAL]
# LOGIN_URL=


# ┌───────────────────────────────────────────────────────────────
# │  PERMISOS POR ROL       ·  agente probador-permisos
# └───────────────────────────────────────────────────────────────
#
# Roles a probar (el anónimo, sin sesión, se prueba siempre). Sin PERMISOS_ROLES se usa APP_USER/APP_PASSWORD como rol "usuario".
# Todo este bloque es [OPCIONAL].
# PERMISOS_ROLES=admin,operador,invitado
#
# Por rol (el nombre en mayúsculas, sin acentos y con _ en lugar de espacios):  [SECRETO]
# PERMISOS_ADMIN_USUARIO=
# PERMISOS_ADMIN_CLAVE=
# Token para probar los endpoints de API con ese rol (Authorization: Bearer):  [OPCIONAL] [SECRETO]
# PERMISOS_ADMIN_TOKEN=
# Página de login (por defecto, la URL inicial) y selectores, si el login no se detecta solo:  [OPCIONAL]
# PERMISOS_LOGIN_URL=
# PERMISOS_SELECTOR_USUARIO=
# PERMISOS_SELECTOR_CLAVE=
# PERMISOS_SELECTOR_ENVIAR=




# ╔═══════════════════════════════════════════════════════════════╗
# ║   2 · API Y AUTOMATIZACIÓN CON k0lmena                        ║
# ╚═══════════════════════════════════════════════════════════════╝


# ┌───────────────────────────────────────────────────────────────
# │  PRUEBAS DE API         ·  Newman (agente ejecutor-api)
# └───────────────────────────────────────────────────────────────
#
# Token para autenticar los requests de API (si tu colección usa {{token}}).
# Lo pasa scripts/correr_newman.py (agente ejecutor-api) como la variable {{token}} de la colección.
# [OPCIONAL]  [SECRETO]
# API_TOKEN=


# ┌───────────────────────────────────────────────────────────────
# │  AUTOMATIZACIÓN k0lmena ·  herramientas/k0lmena
# └───────────────────────────────────────────────────────────────
#
# k0lmena lee ESTE mismo .env (no hay otro). También usa APP_USER, APP_PASSWORD y API_TOKEN de arriba.
# Casi todo acá tiene un valor por defecto razonable: tocá solo lo que necesites.  [OPCIONAL]

# Filtro de escenarios (vacío = todos). Ej: @HU-001   |   @smoke and not @wip
TAGS=
# Paralelo en web/api: vacío o 0 = secuencial | on = un worker por CPU | N = N workers
PARALLEL=

#  · · ·  Web (Playwright + Cucumber). La URL es APP_URL (arriba).  · · ·
BROWSER=chromium
HEADLESS=true
SLOWMO=0
REPORT_DIR=reports/web
# Evidencias en el reporte (web y mobile):
#   TRACE: off | on | on-failure  (trace de Playwright, para abrir en trace.playwright.dev)
#   VIDEO: off | on | on-failure  (video completo de la ejecución)
#   EVIDENCE: captura | ambos | off  (de cada escenario que pasa: captura final, o captura + GIF del recorrido)
#             Vacío = npm test lo pregunta al arrancar (en CI usa "captura").
TRACE=on-failure
VIDEO=on-failure
EVIDENCE=
VIEWPORT_WIDTH=1366
VIEWPORT_HEIGHT=768
LOCALE=es-AR
TIMEZONE=America/Argentina/Mendoza

#  · · ·  Auto-healing de locators: off | learn | heal | on  · · ·
K0LMENA_AUTO_HEALING=on
K0LMENA_AUTO_HEALING_FLUSH=debounced
K0LMENA_AUTO_HEALING_WRITE_PRETTY=0
K0LMENA_AUTO_HEALING_LOG=0
K0LMENA_AUTO_HEALING_CONSOLE=1
K0LMENA_AUTO_HEALING_HISTORY_PATH=.k0lmena/auto-healing/front-history.json
K0LMENA_AUTO_HEALING_MAX_CANDIDATES=12
K0LMENA_AUTO_HEALING_SNAPSHOT_TIMEOUT_MS=250
K0LMENA_AUTO_HEALING_CANDIDATE_TIMEOUT_MS=1500

#  · · ·  API (axios + Cucumber). El token es API_TOKEN (arriba).  · · ·
# API_BASEURL es el server de la spec CON su basePath (lo calcula python scripts/resumir_openapi.py <spec>):
# los endpoints del .feature van con el path de la spec tal cual ("/pet/{petId}"), sin repetir el /v2.
API_BASEURL=https://petstore.swagger.io/v2
# Autenticación según el securityScheme de la spec (ver el skill automatizacion-k0lmena):
#   Bearer / OAuth2 -> API_TOKEN · apiKey (header o query) -> API_KEY (si falta, se usa API_TOKEN) · basic -> API_USER y API_PASSWORD
# [OPCIONAL]  [SECRETO]
# API_KEY=
# API_USER=
# API_PASSWORD=
# Tiempo máximo de cada request de API, en ms (por defecto 30000):
# API_TIMEOUT_MS=
# Endpoint GraphQL para los steps de GraphQL (opcional): relativo a API_BASEURL o una URL completa.
# Vacío = API_BASEURL + /graphql
# GRAPHQL_URL=

#  · · ·  Mobile (WebdriverIO + Appium)  · · ·
# MOBILE_TARGET: device | emulator | browserstack     MOBILE_PLATFORM: Android | iOS
MOBILE_TARGET=emulator
MOBILE_PLATFORM=Android
MOBILE_DEVICE_NAME=emulator-5554
MOBILE_PLATFORM_VERSION=
# Archivo dentro de herramientas/k0lmena/mobile/apps/ (o ruta absoluta)
MOBILE_APP=app.apk
# Solo MOBILE_TARGET=device (sale de `adb devices`)
MOBILE_UDID=
# Solo MOBILE_TARGET=browserstack (BROWSERSTACK_APP = bs://... de la app subida).  [SECRETO]
BROWSERSTACK_USER=
BROWSERSTACK_KEY=
BROWSERSTACK_APP=
BROWSERSTACK_BUILD=k0lmenIA

#  · · ·  Performance (npm run perf, agente performance-mapper)  · · ·
# La carga y los umbrales van en cada script; k6 usa API_BASEURL / BASEURL y el token API_TOKEN. Opcionales:
#   PERF_VUS / PERF_DURACION: pisan la carga de un script k6 en todas las corridas (ej. 5 y 1m)
PERF_VUS=
PERF_DURACION=




# ╔═══════════════════════════════════════════════════════════════╗
# ║   3 · BASES DE DATOS                                          ║
# ╚═══════════════════════════════════════════════════════════════╝


# ┌───────────────────────────────────────────────────────────────
# │  BASES DE DATOS         ·  agente verificador-datos + steps de BD
# └───────────────────────────────────────────────────────────────
#
# Conexiones con nombre; la primera es la de por defecto. Motores: postgres | mysql | mariadb | sqlserver | mongodb
# Por conexión: DB_<NOMBRE>_URL (opcional, reemplaza host/puerto/base/usuario/clave) o HOST, PUERTO, BASE, USUARIO, CLAVE.
# Seguridad: solo lectura por defecto. ESCRITURA=si permite escribir con confirmación explícita;
# PRODUCCION=si bloquea toda escritura. Recomendado: un usuario de base de datos con permisos de solo lectura.
# Todo este bloque es [OPCIONAL]  [SECRETO].
DB_CONEXIONES=
# DB_PRINCIPAL_MOTOR=postgres
# DB_PRINCIPAL_HOST=localhost
# DB_PRINCIPAL_PUERTO=5432
# DB_PRINCIPAL_BASE=
# DB_PRINCIPAL_USUARIO=
# DB_PRINCIPAL_CLAVE=
# SSL: no | si (cifra y verifica el certificado del servidor) | sin-verificar (acepta certificados
#      autofirmados: solo ambientes de prueba). Con una CA propia, DB_PRINCIPAL_SSL_CA=ruta/ca.pem
# DB_PRINCIPAL_SSL=no
# DB_PRINCIPAL_ESCRITURA=no
# DB_PRINCIPAL_PRODUCCION=no
# Opcionales: DB_FILAS_MAX=50 (filas que muestra el CLI) · DB_TIMEOUT_MS=30000 · DB_ESPERA_MS=5000 (reintentos de los steps)
#             DB_COLUMNAS_SENSIBLES=dni,telefono (se suman a password, token, clave, hash, tarjeta… que ya se enmascaran)




# ╔═══════════════════════════════════════════════════════════════╗
# ║   4 · SEGURIDAD, STREAMING Y CÁMARAS                          ║
# ╚═══════════════════════════════════════════════════════════════╝
#
#   /!\  IMPORTANTE: todo lo de abajo es SOLO sobre equipos o sitios
#        PROPIOS, o con autorización POR ESCRITO de su dueño.
#        Las listas "_AUTORIZADAS/_AUTORIZADOS" son la barrera de
#        seguridad: si algo no está en la lista, NO se prueba.


# ┌───────────────────────────────────────────────────────────────
# │  SEGURIDAD WEB          ·  analista-seguridad, pentester-web (OWASP ZAP en Docker)
# └───────────────────────────────────────────────────────────────
#
# Solo se escanean los sitios de esta lista. Separados por coma; cada URL cubre sus subrutas.
# [OPCIONAL]  (obligatorio solo si vas a usar estos agentes)
SEGURIDAD_URLS_AUTORIZADAS=
# Imagen de ZAP (por defecto ghcr.io/zaproxy/zaproxy:stable):
# ZAP_IMAGEN=
# Pentest ACTIVO (agente pentester-web): el escaneo activo es intrusivo (envía ataques y puede
# modificar datos). Poné "si" SOLO para un sitio propio o con autorización escrita, nunca en
# producción sin ese permiso. Vacío = solo se permite el escaneo pasivo.
# PENTEST_AUTORIZADO=


# ┌───────────────────────────────────────────────────────────────
# │  STREAMING Y PLAYBACK   ·  agente probador-streaming (ffprobe/ffmpeg)
# └───────────────────────────────────────────────────────────────
#
# Solo se prueban las fuentes de esta lista. Separadas por coma.
# Ej.: rtsp://cam.local/stream, https://cdn.mi-app.com/live/
# [OPCIONAL]
STREAMING_FUENTES_AUTORIZADAS=
# Umbrales (si no: 10 fps, 3 s de conexión, 4 s de arranque, 4 s de GOP):
# STREAMING_FPS_MINIMO=10
# STREAMING_LATENCIA_AVISO_S=3
# STREAMING_TTFF_AVISO_S=4
# STREAMING_GOP_AVISO_S=4


# ┌───────────────────────────────────────────────────────────────
# │  CONTROL ONVIF          ·  probador-onvif, verificador-grabaciones (onvif-zeep)
# └───────────────────────────────────────────────────────────────
#
# Solo se prueban las cámaras de esta lista. Host o host:puerto separados por coma.
# Ej.: 192.168.1.50, camara.local:80
# [OPCIONAL]
ONVIF_HOSTS_AUTORIZADOS=
# Credenciales de PRUEBA de la cámara (nunca de producción sin autorización):  [SECRETO]
# ONVIF_USUARIO=
# ONVIF_PASSWORD=
# Estándar del sitio: flaguea cámaras que difieren. Aviso de deriva de reloj en segundos (60):
# ONVIF_TZ_ESPERADA=
# ONVIF_NTP_ESPERADO=
# ONVIF_FIRMWARE_ESPERADO=
# ONVIF_DERIVA_RELOJ_AVISO_S=60
# Retención de grabaciones esperada, en días (agente verificador-grabaciones):
# GRABACIONES_RETENCION_DIAS=30
# Segundos que espera eventos en vivo (pull-point) por defecto si no se pasa --eventos (0 = no):
# ONVIF_EVENTOS_ESPERA_S=0


# ┌───────────────────────────────────────────────────────────────
# │  SEGURIDAD DE CÁMARAS   ·  analista-seguridad-camaras (escaneo pasivo)
# └───────────────────────────────────────────────────────────────
#
# Solo se analizan las cámaras de esta lista. IP o IP:puerto separados por coma.
# Ej.: 192.168.1.50, 192.168.1.51
# [OPCIONAL]
CAMARAS_AUTORIZADAS=




# ╔═══════════════════════════════════════════════════════════════╗
# ║   5 · OTROS AGENTES                                           ║
# ╚═══════════════════════════════════════════════════════════════╝


# ┌───────────────────────────────────────────────────────────────
# │  SALESFORCE             ·  agente probador-salesforce (CLI sf + conector salesforce)
# └───────────────────────────────────────────────────────────────
#
# Prueba una org de Salesforce (SANDBOX). Antes hay que instalar la CLI y autorizar la org:
#   npm install --global @salesforce/cli
#   sf org login web --alias mi-sandbox-qa --instance-url https://test.salesforce.com
# Solo se relevan las orgs de esta lista (alias separados por coma), nunca producción.
# [OPCIONAL]
SALESFORCE_ORGS_AUTORIZADAS=
# La org por defecto si no se pasa --org (y la que usa el conector salesforce): un alias de la lista.
# SALESFORCE_ORG=mi-sandbox-qa
# Objetos para revisar el modelo de sharing (OWD), separados por coma. Vacío = estándar + custom.
# SALESFORCE_OBJETOS=Account,Opportunity,Pedido__c


# ┌───────────────────────────────────────────────────────────────
# │  SCALAR                 ·  agente probador-scalar (conector scalar + npm run scalar)
# └───────────────────────────────────────────────────────────────
#
# Todo este bloque es [OPCIONAL]. Ver CONECTORES.md, sección Scalar.
# URL de conexión del server MCP de tu API (Dashboard de Scalar → MCP), p. ej.
# https://mcp.scalar.com/@mi-equipo/pagos (agregá ?env=staging para elegir el ambiente):
# SCALAR_MCP_URL=
# Token personal (Account → API Keys en https://dashboard.scalar.com/account). Lo usan el conector
# (si no está, OAuth desde /mcp), la descarga de APIs privadas del Registry y la CLI.  [SECRETO]
# SCALAR_API_KEY=
# Namespace del equipo en el Registry (registry.scalar.com/@<namespace>):
# SCALAR_NAMESPACE=


# ┌───────────────────────────────────────────────────────────────
# │  BILLETERAS Y PAGOS     ·  agente probador-billeteras
# └───────────────────────────────────────────────────────────────
#
# No necesita variables propias: usa la API de la billetera (API_BASEURL y el token de la sección 2),
# la base para verificar saldos (sección 3) y las TARJETAS DE PRUEBA del proveedor (Stripe, Mercado
# Pago, Adyen…). Siempre contra un ambiente de PRUEBA / sandbox: nunca dinero ni tarjetas reales.


# ┌───────────────────────────────────────────────────────────────
# │  E-COMMERCE             ·  agentes probador-shopify y probador-wordpress
# └───────────────────────────────────────────────────────────────
#
# Solo se relevan las tiendas de esta lista (URL de la vidriera, separadas por coma). Idealmente
# tiendas de desarrollo o staging. Ej.: https://mi-tienda.myshopify.com, https://staging.mitienda.com
# [OPCIONAL]
ECOMMERCE_URLS_AUTORIZADAS=
#
# --- Shopify (npm run shopify) ---
# Vidriera por defecto si no se pasa --tienda.
# SHOPIFY_TIENDA_URL=https://mi-tienda.myshopify.com
# Admin API (opcional): dominio myshopify y el token de una app personalizada SOLO con alcances read_*
# (read_products, read_inventory, read_themes, read_shipping, read_markets, read_discounts, read_locations).
# Sin token se releva solo la vidriera pública.
# SHOPIFY_TIENDA=mi-tienda.myshopify.com
# SHOPIFY_ADMIN_TOKEN=
# SHOPIFY_API_VERSION=2026-07
# Código del tema para Theme Check (--theme-check, requiere npm install --global @shopify/cli).
# SHOPIFY_TEMA_RUTA=C:/proyectos/mi-tema
# Contraseña de la vidriera si la tienda está protegida (la usa el agente con Playwright).
# SHOPIFY_CONTRASENA_VIDRIERA=
#
# --- WordPress / WooCommerce (npm run wordpress) ---
# Sitio por defecto si no se pasa --sitio.
# WORDPRESS_URL=https://staging.mitienda.com
# REST API de WooCommerce (opcional): clave con permiso de LECTURA
# (WooCommerce → Ajustes → Avanzado → REST API). Sin clave se releva solo lo público.
# WOOCOMMERCE_CONSUMER_KEY=
# WOOCOMMERCE_CONSUMER_SECRET=
# WP-CLI (opcional, --wp-cli): la ruta de la instalación local o el comando completo si corre en Docker.
# WORDPRESS_RUTA_LOCAL=C:/www/mitienda
# WORDPRESS_WP_CLI=docker compose exec -T wordpress wp
#
# --- PrestaShop (npm run prestashop) ---
# Tienda por defecto si no se pasa --tienda.
# PRESTASHOP_URL=https://staging.mitienda.com
# Webservice API (opcional): clave con permiso de SOLO LECTURA (Parámetros avanzados → Webservice).
# Habilitá al menos lectura de: configurations, products, stock_availables, carriers, zones, currencies,
# languages, cart_rules y shops. Sin clave se releva solo la vidriera pública.
# PRESTASHOP_WEBSERVICE_KEY=
# Instalación local (opcional, --local): para leer la versión y si el modo desarrollador quedó encendido.
# PRESTASHOP_RUTA_LOCAL=C:/www/mitienda
#
# --- VTEX (npm run vtex) ---
# Storefront por defecto si no se pasa --tienda (autorizado en ECOMMERCE_URLS_AUTORIZADAS).
# VTEX_URL=https://www.mi-tienda.com
# Cuenta VTEX (si no se deduce de la URL *.myvtex.com / *.vtexcommercestable.com.br).
# VTEX_ACCOUNT=micuenta
# Workspace a probar (por defecto master; para QA usá un workspace propio, p. ej. qa).
# VTEX_WORKSPACE=master
# APIs de administración (opcional): app con roles de SOLO LECTURA (License Manager → Application Keys).
# VTEX_APP_KEY=
# VTEX_APP_TOKEN=
# Canal de ventas por defecto para el catálogo público (opcional).
# VTEX_SALES_CHANNEL=1


# ┌───────────────────────────────────────────────────────────────
# │  CORREOS                ·  agente verificador-correos + steps de correo (Mailpit)
# └───────────────────────────────────────────────────────────────
#
# Buzón de prueba Mailpit (herramientas/mailpit/README.md). La app del ambiente de pruebas manda
# sus mails por SMTP a Mailpit (puerto 1025) y acá va la dirección de su web/API.
# [OPCIONAL]
MAILPIT_URL=http://localhost:8025
# Solo si tu Mailpit pide usuario y clave (--ui-auth):  [SECRETO]
# MAILPIT_USUARIO=
# MAILPIT_CLAVE=
# Segundos que espera el step "llega un correo a ..." (30 por defecto):
# CORREO_TIMEOUT_S=30


# ┌───────────────────────────────────────────────────────────────
# │  REPOSITORIO DE LA APP  ·  agente documentador-proyecto (solo lectura)
# └───────────────────────────────────────────────────────────────
#
# El documentador-proyecto lee el repositorio de la app (README y docs, reglas en el código, mensajes,
# contratos de API, PRs y commits de cada historia) por el conector MCP de su proveedor, SOLO LECTURA,
# y deja lo que encuentra en input/documentacion/ (no se versiona) para el resto de los agentes.
# Todo este bloque es [OPCIONAL].
#   github      → conector "github"       (npm run conector -- activar github)  · usa GITHUB_TOKEN
#   gitlab      → conector "gitlab"       (npm run conector -- activar gitlab)  · usa GITLAB_URL / GITLAB_TOKEN
#   azure-repos → conector "azure-devops" (ya usa ADO_ORGANIZACION / ADO_PAT; el PAT necesita Code: Read)
#   bitbucket   → conector "atlassian" (Bitbucket Cloud), con ATLASSIAN_MCP_AUTENTICACION=token
# REPO_PROVEEDOR=github
# Repositorios, separados por coma (por ejemplo front y back):
#   github: dueño/repo · gitlab: grupo/proyecto · azure-repos: proyecto/repo · bitbucket: workspace/repo
# REPO_NOMBRE=mi-empresa/mi-app-web,mi-empresa/mi-app-api
# Rama que se documenta (vacío = la rama por defecto del repositorio)
# REPO_RAMA=main
# Ruta a un clon local del mismo repositorio. Si está, el código se lee de ahí (más rápido
# y sin gastar tokens del conector); PRs y commits se siguen leyendo por el conector.
# REPO_RUTA_LOCAL=
#
# GitHub: personal access token fine-grained de SOLO LECTURA (Contents, Pull requests, Issues y
# Metadata: Read-only) en https://github.com/settings/personal-access-tokens
# El conector usa el server remoto oficial (api.githubcopilot.com) en modo solo lectura.
# GitHub Enterprise Server no está soportado por el server remoto (ver CONECTORES.md).  [SECRETO]
# GITHUB_TOKEN=
# Toolsets del server (por defecto context,repos,issues,pull_requests):
# GITHUB_TOOLSETS=
#
# GitLab: GitLab.com o self-managed / Dedicated 19.5 o superior (server MCP oficial en /api/v4/mcp).
# GITLAB_URL=https://gitlab.com
# Sin token, te autorizás con tu cuenta (OAuth) desde /mcp. Con token: personal access token
# fine-grained con el recurso "MCP tool" y permiso Execute (los tokens clásicos los rechaza).  [SECRETO]
# GITLAB_TOKEN=
# Toolsets (por defecto meta,core,merge_requests,work_items,repository,wikis):
# GITLAB_TOOLSETS=
#
# Manual de usuario (redactor-manual): equipo que firma el Word del manual (npm run manual -- word).  [OPCIONAL]
# MANUAL_EQUIPO=Equipo de QA
#
# Revisión de código (revisor-codigo: npm run obtener-codigo). Clona por git, no por el conector, y usa
# los tokens de arriba solo con su host: GITHUB_TOKEN (Contents: Read-only), GITLAB_TOKEN (read_repository
# y read_api; el token "MCP tool" del conector no alcanza para clonar), ADO_PAT (Code: Read).
# Repos públicos: no hace falta ninguno.
# Bitbucket Cloud: API token con permisos de lectura de repositorios y PRs (si no, prueba con JIRA_API_TOKEN).
# El email es el de la cuenta Atlassian (si no, usa JIRA_EMAIL).  [OPCIONAL] [SECRETO]
# BITBUCKET_TOKEN=
# BITBUCKET_EMAIL=
# Cualquier otro host (Gitea, Forgejo, Codeberg, GitLab de otro dominio, servidor git propio), o para pisar
# los anteriores: token de solo lectura y el usuario con el que se presenta (por defecto "git").  [OPCIONAL] [SECRETO]
# REVISION_GIT_TOKEN=
# REVISION_GIT_USUARIO=


# ┌───────────────────────────────────────────────────────────────
# │  AVISOS                 ·  Slack y Microsoft Teams (scripts/avisar.py)
# └───────────────────────────────────────────────────────────────
#
# Los usan npm test, el monitoreo y el informe de cierre, cuando se pide o está configurado.
# Son [SECRETO]: quien tiene la URL puede publicar en el canal.
# Slack: Incoming Webhook de una app de Slack (https://hooks.slack.com/services/...)
# SLACK_WEBHOOK_URL=
# Teams: webhook de un flujo de Teams Workflows, plantilla "Post to a channel when a webhook request is
# received" (los Incoming Webhooks de los conectores de Office 365 están retirados)
# TEAMS_WEBHOOK_URL=


# ┌───────────────────────────────────────────────────────────────
# │  MONITOREO SINTÉTICO    ·  npm run monitorear
# └───────────────────────────────────────────────────────────────
#
# Ver herramientas/k0lmena/tools/monitoreo/README.md .  [OPCIONAL]
# URLs a revisar, separadas por coma (o input/monitoreo.json con checks más finos). Solo GET o HEAD.
# MONITOREO_URLS=https://tu-app.com,https://tu-app.com/login
# Link que acompaña el aviso (por ejemplo, la corrida de CI):
# MONITOREO_LINK=


# ┌───────────────────────────────────────────────────────────────
# │  HISTORIAL DE CORRIDAS  ·  todas las herramientas
# └───────────────────────────────────────────────────────────────
#
# Cuántas corridas guarda cada herramienta en historial/ para compararlas (5 por defecto):
# HISTORIAL_CORRIDAS=5


# ┌───────────────────────────────────────────────────────────────
# │  TRADUCCIÓN E IDIOMAS   ·  agente analista-traductor
# └───────────────────────────────────────────────────────────────
#
# Idiomas o regiones a revisar, separados por coma (códigos BCP 47). El primero es el de referencia.  [OPCIONAL]
# TRADUCTOR_IDIOMAS=es-AR,en-US,pt-BR
# Cómo se cambia de idioma en el sitio (por defecto prueba ?lang=, la ruta /xx/ y el encabezado
# Accept-Language). {idioma} y {idioma_corto} se reemplazan: https://mi-app.com/{idioma_corto}/
# TRADUCTOR_URL_IDIOMA=




# ╔═══════════════════════════════════════════════════════════════╗
# ║   6 · INTEGRACIONES                                           ║
# ║       gestión de proyecto · diseño · gestión de pruebas      ║
# ╚═══════════════════════════════════════════════════════════════╝
#
#   Cada equipo usa sus herramientas: completá y descomentá SOLO los bloques que uses.
#   Viene activo Jira + Confluence (conector "atlassian"); el resto está listo, comentado.
#
#   Conectores MCP: vienen activos "playwright", "playwright-headless" y "atlassian". Los demás
#   (Azure DevOps, Figma, GitHub, GitLab, Linear, ClickUp, monday.com, Asana, Trello, Notion, YouTrack,
#   Shortcut, QMetry, AIO Tests, k0lmenaTMT, Appium) los activa cada uno con:
#       npm run conector -- activar azure-devops
#   y reiniciando Claude Code. Sin secretos en ningún archivo versionado: los valores salen de este .env.
#   Guía completa: CONECTORES.md · scripts/gestion/README.md


# ┌───────────────────────────────────────────────────────────────
# │  JIRA Y CONFLUENCE      ·  Atlassian Cloud      [ ✓ ACTIVO POR DEFECTO ]
# └───────────────────────────────────────────────────────────────
#
# Conector MCP "atlassian": historias, comentarios, épicas, issues vinculados y páginas de Confluence.
# También da acceso a Bitbucket Cloud (repositorio de la app), pero solo con ATLASSIAN_MCP_AUTENTICACION=token
# y un API token con los scopes de Bitbucket (ver CONECTORES.md).
# Autenticación del conector:
#   oauth  (por defecto) autorizás con tu cuenta la primera vez, desde /mcp > atlassian. No usa token.
#   token  usa JIRA_EMAIL + JIRA_API_TOKEN. Un admin de Atlassian tiene que habilitarlo en
#          Atlassian Administration > Rovo > Rovo MCP server > Authentication.
ATLASSIAN_MCP_AUTENTICACION=oauth
JIRA_BASE_URL=https://tu-sitio.atlassian.net
JIRA_EMAIL=
# API token personal (también lo usa Xray Cloud para vincular casos con historias):  [SECRETO]
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# En lugar del token personal: API key de una cuenta de servicio (se envía como Bearer).  [OPCIONAL] [SECRETO]
# ATLASSIAN_API_KEY=


# ┌───────────────────────────────────────────────────────────────
# │  AZURE DEVOPS           ·  Boards, Test Plans y Wiki
# └───────────────────────────────────────────────────────────────
#
# Conector MCP "azure-devops": historias, comentarios, Wiki y casos en Azure Test Plans.  [OPCIONAL]
# Organización: solo el nombre, el de https://dev.azure.com/<organizacion>
# ADO_ORGANIZACION=
# Personal Access Token (User settings > Personal access tokens). Scopes mínimos:  [SECRETO]
#   Work Items (Read & write), Test Management (Read & write), Project and Team (Read),
#   Wiki (Read) y Code (Read) para la búsqueda de código y el repositorio (documentador-proyecto).
# ADO_PAT=
# Proyecto y equipo por defecto (si faltan, se indican en cada pedido):
# ADO_PROYECTO=
# ADO_EQUIPO=
# Opcionales:
#   ADO_AUTENTICACION: pat (por defecto, usa ADO_PAT) | interactive (login en el navegador) | azcli (sesión de "az login")
#   ADO_TENANT: tenant de Microsoft Entra (solo interactive o azcli)
#   ADO_DOMINIOS: áreas que se habilitan (por defecto: core work work-items repositories test-plans wiki search)
# ADO_AUTENTICACION=pat
# ADO_TENANT=
# ADO_DOMINIOS=core work work-items repositories test-plans wiki search


# ┌───────────────────────────────────────────────────────────────
# │  FIGMA                  ·  diseños
# └───────────────────────────────────────────────────────────────
#
# Conectores MCP "figma" (remoto) o "figma-desktop" (app de escritorio). No usan variables:
# se autorizan con tu cuenta de Figma desde /mcp. Requiere un asiento Full o Dev.


# ┌───────────────────────────────────────────────────────────────
# │  OTRAS GESTIONES DE PROYECTO  ·  historias, tareas, documentación
# └───────────────────────────────────────────────────────────────
#
# Si tu equipo no usa Jira ni Azure DevOps, las historias se leen igual desde estas herramientas con
# su conector MCP oficial (solo lectura de lo que necesitan los agentes). Activá solo la que uses:
#     npm run conector -- activar linear      (o clickup, monday, asana, trello, notion, youtrack, shortcut)
# Las que dicen "OAuth" no usan variables: la primera vez autorizás con tu cuenta desde /mcp.
# Todas las claves de este bloque son [OPCIONAL]  [SECRETO].
#
# Linear · OAuth. En lugar de OAuth: API key de solo lectura (en tu cuenta, "Security & access" >
# Personal API keys, con permiso Read). El conector usa el endpoint de solo lectura.
# LINEAR_API_KEY=
#
# ClickUp · solo OAuth (ClickUp no acepta API tokens en su server MCP).
# monday.com · OAuth. Opcional: token personal de la API (Avatar > Developers > My access tokens).
# MONDAY_API_TOKEN=
#
# Asana · el server V2 no acepta registro automático: creá una "MCP app" en
# https://app.asana.com/0/my-apps con la redirect URL http://localhost:8080/callback y copiá acá sus datos.
# El secret se guarda en el llavero del sistema al activar el conector (no queda en ningún archivo).
# ASANA_CLIENT_ID=
# ASANA_CLIENT_SECRET=
#
# Trello · solo OAuth (elegís los workspaces en la pantalla de consentimiento).
# Notion · solo OAuth (páginas, bases de datos y wikis que compartas con la conexión).
# Shortcut · solo OAuth.
#
# YouTrack (Cloud o Server) · URL del sitio y un permanent token (Perfil > Account Security > Tokens,
# con el scope YouTrack). Si cambiás la URL, volvé a activar el conector.
# YOUTRACK_URL=https://mi-empresa.youtrack.cloud
# YOUTRACK_TOKEN=
#
# GitHub Issues/Projects y GitLab Issues/work items: los leen los conectores "github" y "gitlab"
# (bloque "Repositorio de la app", en la sección 5).


# ┌───────────────────────────────────────────────────────────────
# │  GESTIÓN DE PRUEBAS     ·  agentes gestor-pruebas y publicador-resultados
# └───────────────────────────────────────────────────────────────
#
# Xray, QTM4J y AIO se integran con scripts/gestion/gestion.py (carpetas, casos, vínculos,
# ciclos y resultados con evidencias). Azure DevOps va por su conector MCP (bloque de arriba).
# [OPCIONAL]
# GESTION_HERRAMIENTA: xray-cloud | xray-dc | qtm4j | aio
# GESTION_PROYECTO: key del proyecto de Jira (ej. PROJ)
# GESTION_HERRAMIENTA=
# GESTION_PROYECTO=

#  · · ·  Xray Cloud  · · ·   [SECRETO]
# Sin MCP oficial: lo integra scripts/gestion. Usa también JIRA_BASE_URL, JIRA_EMAIL y JIRA_API_TOKEN.
# API key de Xray: Xray > Global Settings > API Keys
# XRAY_CLOUD_CLIENT_ID=
# XRAY_CLOUD_CLIENT_SECRET=
# Región (opcional): https://us.xray.cloud.getxray.app | https://eu.xray.cloud.getxray.app | https://au.xray.cloud.getxray.app
# XRAY_CLOUD_URL=https://xray.cloud.getxray.app

#  · · ·  Xray Server / Data Center  · · ·   [SECRETO]
# URL de tu Jira + Personal Access Token (o usuario y contraseña)
# XRAY_DC_URL=https://jira.tu-empresa.com
# XRAY_DC_TOKEN=
# XRAY_DC_USER=
# XRAY_DC_PASSWORD=

#  · · ·  QMetry para Jira Cloud (QTM4J)  · · ·   [SECRETO]
# Lo usan scripts/gestion y el conector MCP "qtm4j". Open API key: QMetry > Configuration > Open API
# Región: https://qtmcloud.qmetry.com (US) | https://syd-qtmcloud.qmetry.com (AU) | https://eu-qtm4j-cloud.qmetry.com (EU)
# QTM4J_API_KEY=
# QTM4J_BASE_URL=https://qtmcloud.qmetry.com
# Solo para las herramientas de automatización del conector MCP (opcional):
# QTM4J_AUTOMATION_API_KEY=

#  · · ·  QMetry Test Management (standalone)  · · ·   [SECRETO]
# Conector MCP "qmetry" (server oficial de SmartBear). Open API key de QMetry.
# QMETRY_API_KEY=
# QMETRY_BASE_URL=https://testmanagement.qmetry.com

#  · · ·  AIO Tests (Jira Cloud)  · · ·   [SECRETO]
# Lo usan scripts/gestion y el conector MCP "aio-tests". API token: AIO Tests > My Settings > API Token
# AIO_API_TOKEN=
# URL del server MCP (única por tenant): AIO Tests > My Settings > MCP Authorization
# AIO_MCP_URL=https://tcms-prod-us.aiojiraapps.com/aiotcms-mcp/v1/<tu-tenant-id>/mcp

#  · · ·  k0lmenaTMT  · · ·   [SECRETO]
# Conector MCP "k0lmena-tmt". Token personal (kolm_pat_...) generado en k0lmenaTMT.
# K0LMENA_TMT_TOKEN=
# La URL por defecto es http://localhost:4000/api/v1/mcp. Para otra, definila acá ANTES de
# "npm run conector -- activar k0lmena-tmt" (si la cambiás, volvé a activarlo) o en el entorno:
# K0LMENA_TMT_URL=http://localhost:4000/api/v1/mcp


# ┌───────────────────────────────────────────────────────────────
# │  APPIUM                 ·  mobile-mapper
# └───────────────────────────────────────────────────────────────
#
# Conector MCP "appium-mcp": ruta al Android SDK, si no está en el entorno.  [OPCIONAL]
# ANDROID_HOME=


# ┌───────────────────────────────────────────────────────────────
# │  AJUSTES FINOS DE scripts/gestion  ·  ver scripts/gestion/README.md
# └───────────────────────────────────────────────────────────────
#
# Todo [OPCIONAL]: casi nunca hace falta tocarlo.
# GESTION_LIMITE_ADJUNTO_MB=   tope de tamaño por evidencia (Xray Server/DC: 10 por defecto)
# GESTION_ENVIAR_PRIORIDAD=0   no enviar prioridad al crear casos (si tu Jira usa otros nombres)
# GESTION_PRIORIDADES={"Crítica":"Highest","Alta":"High","Media":"Medium","Baja":"Low"}
# XRAY_LINK_CASO=Test          tipo de vínculo caso-historia (Server/DC: se detecta solo)
# XRAY_LINK_CICLO=Relates      tipo de vínculo ejecución-historia
# XRAY_LINK_INVERTIR=1         si el vínculo queda al revés (la historia debe decir "is tested by")
# XRAY_ESTADOS / QTM4J_ESTADOS / AIO_ESTADOS   JSON para mapear estados propios, ej. {"bloqueado":"BLOCKED"}
# AIO_ESTADO_CASO=Published    estado con el que se crean los casos en AIO
