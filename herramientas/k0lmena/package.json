{
  "name": "k0lmena",
  "version": "1.0.0",
  "private": true,
  "description": "k0lmena automation framework (web, api, mobile y performance) integrado en k0lmenIA",
  "scripts": {
    "test": "node run-tests.js",
    "test:web": "node run-tests.js web",
    "test:api": "node run-tests.js api",
    "test:mobile": "node run-tests.js mobile",
    "test:all": "node run-tests.js all",
    "report:web": "node reports/web/report-generator.js",
    "report:api": "node reports/api/report-generator.js",
    "report:mobile": "ts-node reports/mobile/generate-report.ts",
    "perf": "node run-perf.js",
    "bootstrap:k6:win": "powershell -ExecutionPolicy Bypass -File performance/k6/scripts/bootstrap-k6.ps1",
    "bootstrap:k6:nix": "bash performance/k6/scripts/bootstrap-k6.sh",
    "bootstrap:k6": "node -e \"process.platform==='win32'?process.exit(0):process.exit(1)\" && npm run bootstrap:k6:win || npm run bootstrap:k6:nix",
    "k6:build": "node performance/k6/esbuild.k6.config.mjs",
    "crawler": "ts-node -r ./env.js tools/crawler/locators-generator.ts",
    "link-tester": "npx ts-node -r ./env.js tools/link-tester/tester.ts",
    "link-tester:full": "npx ts-node -r ./env.js tools/link-tester/tester.ts -full",
    "debug": "cross-env CUCUMBER_DEBUG=1 npx cucumber-js --profile debug",
    "record": "node -r ./env.js tools/generator/codegen.js",
    "record:generator": "ts-node -r ./env.js tools/generator/record-generator.ts"
  },
  "author": "Danilo Vezzoni",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^13.0.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "@wdio/appium-service": "^9.29.1",
    "@wdio/browserstack-service": "^9.29.1",
    "@wdio/cli": "^9.29.1",
    "@wdio/cucumber-framework": "^9.29.1",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "appium": "^3.5.2",
    "artillery": "^2.0.33",
    "artillery-engine-playwright": "^1.30.0",
    "cross-env": "^10.1.0",
    "cucumber-html-reporter": "^7.2.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.1",
    "globby": "^16.2.0",
    "multiple-cucumber-html-reporter": "^4.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "webdriverio": "^9.29.1"
  },
  "dependencies": {
    "@artilleryio/playwright-reporter": "^1.1.3",
    "artillery-plugin-html-report": "^2.0.0",
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.4",
    "semver": "^7.8.5",
    "tmp": "^0.2.7",
    "esbuild": "^0.28.1",
    "undici": "^6.27.0",
    "uuid": "^11.1.1",
    "@opentelemetry/core": "^2.8.0",
    "playwright-core": "1.61.1",
    "playwright": "1.61.1",
    "@playwright/browser-chromium": "1.61.1",
    "reflect-metadata": "^0.2.2"
  }
}
