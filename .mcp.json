{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "node",
      "args": [
        "scripts/mcp/playwright.js"
      ]
    },
    "playwright-headless": {
      "type": "stdio",
      "command": "node",
      "args": [
        "scripts/mcp/playwright.js",
        "--headless"
      ]
    },
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v2/mcp",
      "headersHelper": "node scripts/mcp/atlassian-headers.js"
    }
  }
}
